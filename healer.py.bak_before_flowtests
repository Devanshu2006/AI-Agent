"""AI-assisted self-healing of generated tests.

The AI proposes exact-text replacements. Before anything is kept we check that
the patch (1) targets an allowed generated file, (2) does not weaken the test,
and (3) leaves all generated code syntactically valid and policy-clean.
Otherwise every file is restored from the backup.
"""
import json
import os
import re
import shutil
from datetime import datetime
from pathlib import Path

from agent import analyze_failure
from code_validator import collect_validation_errors
from generator import parse_json_response

GENERATED_ROOT = "generated_tests"
ALLOWED_DIRECTORIES = (
    os.path.join(GENERATED_ROOT, "pages"),
    os.path.join(GENERATED_ROOT, "tests"),
)
# Never healed: generated by our own code, or intentionally failing bug tests.
PROTECTED_FILES = {"__init__.py", "conftest.py", "test_bugs.py", "test_forms.py"}
FORBIDDEN_NEW_TEXT = (
    "time.sleep", "wait_for_timeout", "assert True",
    "pytest.skip", "pytest.xfail", "pytest.mark.skip", "pytest.mark.xfail",
)


# ============================================================
# FILE COLLECTION
# ============================================================

def collect_generated_files(include_protected=True):
    found = []
    for root, dirs, files in os.walk(GENERATED_ROOT):
        dirs[:] = [d for d in dirs if d not in ("backups", "__pycache__", "test-output")]
        for filename in files:
            if not filename.endswith(".py"):
                continue
            if not include_protected and filename in PROTECTED_FILES:
                continue
            found.append(os.path.join(root, filename))
    return found


def read_generated_files():
    """Files shown to the AI (protected files are left out to save tokens)."""
    result = {}
    for file_path in collect_generated_files(include_protected=False):
        try:
            with open(file_path, "r", encoding="utf-8") as file:
                result[file_path] = file.read()
        except OSError as error:
            print(f"[Healer] Could not read {file_path}: {error}")
    return result


def is_allowed_file(file_path):
    """Only .py files directly inside generated pages/ or tests/, not protected."""
    try:
        target = Path(file_path).resolve()
    except (OSError, ValueError):
        return False
    if target.suffix != ".py" or target.name in PROTECTED_FILES:
        return False
    return any(target.parent == Path(d).resolve() for d in ALLOWED_DIRECTORIES)


# ============================================================
# BACKUP / RESTORE
# ============================================================

def backup_generated_files(attempt):
    backup_directory = os.path.join(GENERATED_ROOT, "backups", f"attempt_{attempt}")
    os.makedirs(backup_directory, exist_ok=True)

    for file_path in collect_generated_files():
        backup_path = os.path.join(backup_directory, os.path.relpath(file_path, GENERATED_ROOT))
        os.makedirs(os.path.dirname(backup_path), exist_ok=True)
        shutil.copy2(file_path, backup_path)

    print(f"\n[Healer] Backup created: {backup_directory}")
    return backup_directory


def restore_backup(backup_directory):
    if not os.path.exists(backup_directory):
        print("[Healer] Backup directory does not exist.")
        return False

    for root, _, files in os.walk(backup_directory):
        for filename in files:
            backup_path = os.path.join(root, filename)
            target = os.path.join(GENERATED_ROOT, os.path.relpath(backup_path, backup_directory))
            os.makedirs(os.path.dirname(target), exist_ok=True)
            shutil.copy2(backup_path, target)

    print("[Healer] Previous generated code restored.")
    return True


# ============================================================
# PATCHING
# ============================================================

def weakens_test(old_text, new_text):
    """True if the patch removes assertions or adds known test-weakening code."""
    if any(token in new_text for token in FORBIDDEN_NEW_TEXT):
        return "patch adds skip/xfail/sleep/assert-True code"
    if re.search(r"(?m)^\s*pass\s*$", new_text) and not re.search(r"(?m)^\s*pass\s*$", old_text):
        return "patch adds a bare `pass`"

    def assertions(text):
        return text.count("assert ") + text.count("expect(")

    if assertions(new_text) < assertions(old_text):
        return "patch removes assertions"
    return None


def apply_patch(patch):
    file_path = patch.get("file", "")
    old_text = patch.get("old_text", "")
    new_text = patch.get("new_text", "")

    if not is_allowed_file(file_path):
        return False, "File is outside the allowed generated directories (or protected)."
    if patch.get("operation") != "replace":
        return False, "Only the replace operation is allowed."
    if not old_text:
        return False, "old_text is empty."
    if not os.path.exists(file_path):
        return False, "Target file does not exist."

    reason = weakens_test(old_text, new_text)
    if reason:
        return False, f"Rejected: {reason}."

    try:
        with open(file_path, "r", encoding="utf-8") as file:
            content = file.read()
    except OSError as error:
        return False, str(error)

    count = content.count(old_text)
    if count != 1:
        return False, f"old_text must occur exactly once. Found: {count}"

    try:
        with open(file_path, "w", encoding="utf-8") as file:
            file.write(content.replace(old_text, new_text, 1))
    except OSError as error:
        return False, str(error)

    print(f"[Healer] Patch applied: {file_path}")
    return True, "Patch applied successfully."


def save_healing_report(attempt, result):
    report_path = os.path.join(GENERATED_ROOT, f"healing_report_attempt_{attempt}.json")
    with open(report_path, "w", encoding="utf-8") as file:
        json.dump(result, file, indent=4, default=str)
    print(f"[Healer] Healing report saved: {report_path}")


def _finish(attempt, result):
    save_healing_report(attempt, result)
    return result


# ============================================================
# MAIN HEALING FUNCTION
# ============================================================

def heal_failed_tests(website_data, execution_result, attempt):
    print(f"\n========== AI SELF HEALING (ATTEMPT {attempt}) ==========")

    if execution_result.get("failed", 0) == 0 and execution_result.get("errors", 0) == 0:
        print("\n[Healer] No failures detected.")
        return _finish(attempt, {
            "safe_to_auto_heal": False, "healed": False, "reason": "No failures",
        })

    print("\n[Healer] Sending failure to AI...")
    try:
        ai_response = analyze_failure(
            website_data, execution_result, read_generated_files()
        )
    except Exception as error:
        print(f"\n[Healer] AI analysis failed: {error}")
        return _finish(attempt, {
            "safe_to_auto_heal": False, "healed": False,
            "reason": f"AI analysis failed: {error}",
        })

    try:
        healing_plan = parse_json_response(ai_response)
        if not isinstance(healing_plan, dict):
            raise ValueError("healing plan is not a JSON object")
    except (ValueError, TypeError) as error:
        print(f"\n[Healer] AI returned an unusable healing plan: {error}")
        return _finish(attempt, {
            "safe_to_auto_heal": False, "healed": False,
            "reason": "Invalid AI healing response", "ai_response": str(ai_response),
        })

    print(f"\n[Healer] Diagnosis : {healing_plan.get('root_cause', 'Unknown')}")
    print(f"[Healer] Category  : {healing_plan.get('failure_category', 'Unknown')}")
    print(f"[Healer] Confidence: {healing_plan.get('confidence', 'Unknown')}")

    if not healing_plan.get("safe_to_auto_heal", False):
        print("\n[Healer] AI marked this failure as unsafe to auto-heal.")
        return _finish(attempt, {**healing_plan, "healed": False})

    patches = healing_plan.get("patches", [])
    if not patches:
        print("\n[Healer] No patches proposed.")
        return _finish(attempt, {**healing_plan, "healed": False})

    backup_directory = backup_generated_files(attempt)
    applied = []

    for patch in patches:
        success, message = apply_patch(patch)
        if not success:
            print(f"\n[Healer] Patch rejected: {message}")
            restore_backup(backup_directory)
            return _finish(attempt, {
                **healing_plan, "healed": False, "reason": message,
                "applied_patches": [],
            })
        applied.append(patch)

    problems = collect_validation_errors(GENERATED_ROOT)
    if problems:
        print("\n[Healer] Patched code failed validation:")
        for problem in problems:
            print(f"  - {problem}")
        restore_backup(backup_directory)
        return _finish(attempt, {
            **healing_plan, "healed": False,
            "reason": "Patch failed validation", "validation_errors": problems,
            "applied_patches": applied,
        })

    print("\n[Healer] Patch validated successfully. Ready for test rerun.")
    return _finish(attempt, {
        **healing_plan, "healed": True, "backup_directory": backup_directory,
        "applied_patches": applied, "timestamp": datetime.now().isoformat(),
    })
